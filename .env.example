# Conexão com o Postgres (Neon, Supabase, Vercel Postgres...).
# No Neon use a "Pooled connection string" (com "-pooler" no host).
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo usado para assinar o cookie de sessão do painel.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"

# Opcional: cria automaticamente o primeiro usuário do painel no primeiro acesso,
# caso ainda não exista nenhuma conta cadastrada.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="uma-senha-forte"

# Opcional: fuso usado apenas para sugerir a data/hora padrão do formulário.
# APP_TIMEZONE="America/Sao_Paulo"
